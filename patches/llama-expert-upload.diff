     copy_experts_info copy_experts;
 
+    // pinned host ring used by sched_copy_experts to upload the experts kept in host memory (mmap):
+    // a cudaMemcpyAsync straight from pageable mmap memory is a synchronous, staged copy on the host
+    // thread (very slow on ROCm), so the rows are first copied by several threads into pinned chunks
+    // and DMAed from there, overlapping the memcpy of one chunk with the transfer of the previous ones
+    struct copy_experts_ring {
+        ggml_backend_t backend = nullptr;
+        size_t chunk_size = 0;
+
+        std::vector<ggml_backend_buffer_ptr> bufs;
+        std::vector<ggml_backend_event_ptr>  events;  // null entries: fall back to a full backend sync
+        std::vector<char>                    pending; // chunk has an upload in flight
+        size_t next = 0;
+    };
