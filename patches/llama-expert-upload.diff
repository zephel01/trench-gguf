+    std::vector<copy_experts_ring> copy_rings; // one per backend that receives host experts
+
+    // returns the ring of this backend, created on first use, or nullptr if the upload must be direct
+    copy_experts_ring * copy_ring_get(ggml_backend_t backend);
+
+    // upload [offset, offset + size) of the host tensor src into dst, through the pinned ring when available
+    void copy_experts_upload(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, size_t offset, size_t size);
+
     // graph reallocations during inference where the backend assignments did not change, split by whether the
     // graph size is the same as the previously scheduled one (unexpected) or different
     int32_t n_reallocs_same = 0;
