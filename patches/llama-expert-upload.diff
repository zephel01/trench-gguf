+// expert upload through a pinned host ring
+//
+// LLAMA_EXPERT_UPLOAD_DIRECT=1   : disable the ring, cudaMemcpyAsync straight from the mmap (previous behavior)
+// LLAMA_EXPERT_UPLOAD_CHUNK_MIB=N: size of a pinned chunk (default 64)
+// LLAMA_EXPERT_UPLOAD_RING=N     : number of chunks in flight (default 4)
+// LLAMA_EXPERT_UPLOAD_THREADS=N  : threads doing the host memcpy into a chunk (default min(n_threads_batch, 8))
+
+static size_t copy_experts_env(const char * name, size_t def) {
+    const char * s = getenv(name);
+    if (!s || !*s) {
+        return def;
+    }
+    const long v = atol(s);
+    return v > 0 ? (size_t) v : def;
+}
+
+llama_context::copy_experts_ring * llama_context::copy_ring_get(ggml_backend_t backend) {
+    static const bool direct = copy_experts_env("LLAMA_EXPERT_UPLOAD_DIRECT", 0) != 0;
+    if (direct) {
+        return nullptr;
+    }
+
+    for (auto & ring : copy_rings) {
+        if (ring.backend == backend) {
+            return ring.bufs.empty() ? nullptr : &ring;
+        }
+    }
+
+    // first use of this backend: create its ring, an empty ring marks a backend that cannot use one
+    copy_rings.emplace_back();
+    auto & ring = copy_rings.back();
+    ring.backend = backend;
+
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_buffer_type_t host_buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+    if (!host_buft) {
+        return nullptr;
+    }
+
+    const size_t chunk_size = copy_experts_env("LLAMA_EXPERT_UPLOAD_CHUNK_MIB", 64) * 1024 * 1024;
+    const size_t n_chunks   = copy_experts_env("LLAMA_EXPERT_UPLOAD_RING", 4);
+
+    for (size_t i = 0; i < n_chunks; ++i) {
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(host_buft, chunk_size);
+        if (!buf) {
+            LLAMA_LOG_WARN("%s: failed to allocate a %zu MiB pinned chunk for %s, uploading experts directly\n",
+                    __func__, chunk_size/1024/1024, ggml_backend_name(backend));
+            ring.bufs.clear();
+            ring.events.clear();
+            return nullptr;
+        }
+        ring.bufs.emplace_back(buf);
+        ring.events.emplace_back(ggml_backend_event_new(dev)); // may be null, then a full sync is used
+    }
+    ring.pending.assign(n_chunks, 0);
+    ring.chunk_size = chunk_size;
+    ring.next = 0;
+
+    LLAMA_LOG_INFO("%s: %s: experts uploaded through %zu pinned chunks of %zu MiB\n",
+            __func__, ggml_backend_name(backend), n_chunks, chunk_size/1024/1024);
+
+    return &ring;
+}
+
+void llama_context::copy_experts_upload(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, size_t offset, size_t size) {
+    copy_experts_ring * ring = copy_ring_get(backend);
+    if (!ring) {
+        ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + offset, offset, size);
+        return;
+    }
+
+    static const size_t n_threads_env = copy_experts_env("LLAMA_EXPERT_UPLOAD_THREADS", 0);
+    const size_t n_threads = std::max<size_t>(1, n_threads_env ? n_threads_env : std::min<uint32_t>(cparams.n_threads_batch, 8));
+
+    const uint8_t * src_data = (const uint8_t *) src->data + offset;
+
+    for (size_t done = 0; done < size; ) {
+        const size_t len  = std::min(size - done, ring->chunk_size);
+        const size_t slot = ring->next % ring->bufs.size();
+
+        // wait until the previous upload from this chunk has been consumed by the device
+        if (ring->pending[slot]) {
+            if (ring->events[slot]) {
+                ggml_backend_event_synchronize(ring->events[slot].get());
+            } else {
+                ggml_backend_synchronize(backend);
+            }
+            ring->pending[slot] = 0;
+        }
+
+        uint8_t * chunk = (uint8_t *) ggml_backend_buffer_get_base(ring->bufs[slot].get());
+
+        // host memcpy mmap -> pinned chunk, split across threads (page faults of the mmap are served in parallel too)
+        const size_t n_parts = std::min<size_t>(n_threads, std::max<size_t>(1, len / (4u*1024*1024)));
+        if (n_parts <= 1) {
+            memcpy(chunk, src_data + done, len);
+        } else {
+            std::vector<std::thread> workers;
+            workers.reserve(n_parts - 1);
+            const size_t part = (len + n_parts - 1) / n_parts;
+            for (size_t p = 1; p < n_parts; ++p) {
+                const size_t beg = std::min(len, p*part);
+                const size_t end = std::min(len, beg + part);
+                if (beg < end) {
+                    workers.emplace_back([=]() { memcpy(chunk + beg, src_data + done + beg, end - beg); });
+                }
+            }
+            memcpy(chunk, src_data + done, std::min(len, part));
+            for (auto & w : workers) {
+                w.join();
+            }
+        }
+
+        ggml_backend_tensor_set_async(backend, dst, chunk, offset + done, len);
+        if (ring->events[slot]) {
+            ggml_backend_event_record(ring->events[slot].get(), backend);
+        }
+        ring->pending[slot] = 1;
+        ring->next++;
+
+        done += len;
+    }
+}
